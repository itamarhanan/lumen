{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/www": {
      "entry": ["src/app/**/page.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@base-ui/react",
        "cmdk",
        "embla-carousel-react",
        "input-otp",
        "postcss",
        "react-day-picker",
        "react-resizable-panels",
        "shadcn",
        "sonner",
        "tailwindcss",
        "tw-animate-css",
        "vaul"
      ]
    },
    "apps/ingest": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@nestjs/mapped-types",
        "@nestjs/testing",
        "@types/supertest",
        "supertest",
        "source-map-support",
        "ts-loader",
        "ts-node",
        "tsconfig-paths"
      ]
    },
    "packages/clickhouse": {
      "ignoreDependencies": ["@eslint/js", "globals", "typescript-eslint"]
    }
  },
  "ignore": [
    "apps/www/src/components/ui/**",
    "packages/config/tsconfig.www.json",
    "apps/www/src/components/dashboard/journeys/flow-sankey.tsx",
    "apps/www/src/lib/analytics/normalize-path.ts",
    "apps/www/src/lib/analytics/aggregate-sankey.ts",
    "apps/www/src/components/dashboard/journeys/path-nodes.tsx"
  ],
  "ignoreDependencies": [
    "supabase",
    "@next/eslint-plugin-next",
    "@eslint/eslintrc"
  ]
}
