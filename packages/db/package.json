{
  "name": "@lumen/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./as-user": "./src/as-user.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres npx tsx src/seed.ts",
    "db:setup": "tsx src/setup-roles.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@lumen/config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "globals": "catalog:",
    "tsx": "^4.22.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.1"
}
